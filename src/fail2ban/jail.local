[DEFAULT]
bantime = 30m
findtime = 30m
maxretry = 12
banaction = nginx-deny
protocol = tcp
port = http,https
ignoreip = 127.0.0.1/8 ::1/128
loglevel = DEBUG

# Explicitly disable SSH jails
[sshd]
enabled = false

[sshd-ddos]
enabled = false

[ssh-iptables]
enabled = false

[nginx-http-auth]
enabled = true
filter = nginx-http-auth
logpath = /var/proxma/logs/nginx_access.log
bantime = 30m
findtime = 60m
maxretry = 15
port = http,https

[nginx-http-auth-proxma]
enabled = true
filter = nginx-http-auth-proxma
logpath = /var/proxma/logs/nginx_access.log
findtime = 45m
maxretry = 15
bantime = 30m
port = http,https
banaction = nginx-deny

[nginx-bad-request]
enabled = true
filter = nginx-bad-request
logpath = /var/proxma/logs/nginx_access.log
bantime = 30m
findtime = 60m
maxretry = 15
port = http,https

[nginx-botsearch]
enabled = true
filter = nginx-botsearch
logpath = /var/proxma/logs/nginx_access.log
bantime = 30m
findtime = 60m
maxretry = 12
port = http,https

[nginx-probing]
enabled = true
filter = nginx-probing
logpath = /var/proxma/logs/nginx_access.log
findtime = 30m
maxretry = 12
bantime = 30m
port = http,https

[nginx-request-flood]
enabled = true
filter = nginx-http-errors
logpath = /var/proxma/logs/nginx_access.log
findtime = 5m
maxretry = 40
bantime = 30m
port = http,https
